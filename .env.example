DATABASE_URL=
SHADOW_DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
RESEND_API_KEY=

# Server-only merchant order notifications. Apply db:deploy before enabling.
# Recipient: +201152606234. Use a separate WhatsApp Business sender.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved Arabic template with three positional body parameters, e.g.
# طلب جديد رقم {{1}}. الجزء {{2}}. تفاصيل الطلب: {{3}}. يرجى مراجعة الطلب.
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_GRAPH_VERSION=v23.0
# Used by Vercel Cron to retry pending messages.
CRON_SECRET=

# Server-only Telegram merchant order notifications. Apply db:deploy before enabling.
# Send /start to the bot,
# then use getUpdates with your private token to find your numeric chat ID.
# Keep the token in environment variables; never commit or share it.
TELEGRAM_BOT_TOKEN=
# Numeric private chat ID of the brand owner; messages and customer photos go only here.
TELEGRAM_OWNER_CHAT_ID=
